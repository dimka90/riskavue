# Copy to .env and fill in the values yourself. Never commit .env.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
PAIRING_SECRET=
APP_ORIGIN=
# Both BINANCE_API_SECRET and the existing BINANCE_SECRET_KEY spelling work.
# Paper mode is the default. Binance mode is hard-wired to DEMO hosts.
EXCHANGE_MODE=paper
HOST=127.0.0.1
PORT=3001
DATA_DIR=data
# Required for HOST=0.0.0.0 / deployment. Generate a long random value.
APP_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-5
